---
import '@fontsource/press-start-2p';
import '@fontsource/pixelify-sans/400.css';
import '@fontsource/pixelify-sans/600.css';
import '@fontsource/fredoka/400.css';
import '@fontsource/fredoka/500.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  current?: 'home' | 'blog';
}
const { title, description, current } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Naman Gururani" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Naman's World — Blog" href="/rss.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <script is:inline>
      // Set before first paint to avoid theme flash.
      try {
        const t = localStorage.getItem('theme');
        if (t === 'day' || t === 'night') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <header class="site">
      <div class="wrap bar">
        <a class="brand" href="/">NAMAN'S&nbsp;WORLD</a>
        <nav class="top" aria-label="Site">
          <a href="/blog/" aria-current={current === 'blog' ? 'page' : undefined}>Blog</a>
          <a href="/lineage/">Portfolio</a>
          <a href="https://github.com/naman-gururani">GitHub</a>
          <button id="theme-toggle" type="button" aria-label="Toggle day/night theme" title="Day / night">☾</button>
        </nav>
      </div>
    </header>

    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>

    <footer class="site">
      <div class="wrap">
        <span>© 2026 Naman Gururani</span>
        <a href="/rss.xml">RSS</a>
        <a href="mailto:gururaninaman@gmail.com">Email</a>
        <span>Built with Astro · designed after <a href="/lineage/">Lineage Isle</a></span>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const btn = document.getElementById('theme-toggle');
        if (!btn) return;
        const effective = () => {
          const forced = document.documentElement.dataset.theme;
          if (forced === 'day' || forced === 'night') return forced;
          return matchMedia('(prefers-color-scheme: dark)').matches ? 'night' : 'day';
        };
        const paint = () => { btn.textContent = effective() === 'night' ? '☀' : '☾'; };
        btn.addEventListener('click', () => {
          const next = effective() === 'night' ? 'day' : 'night';
          document.documentElement.dataset.theme = next;
          try { localStorage.setItem('theme', next); } catch {}
          paint();
        });
        paint();
      })();
    </script>
  </body>
</html>
