---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';

type Post = CollectionEntry<'blog'>;

export async function getStaticPaths() {
  // Oldest first, so "previous" is the post written before this one.
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf(),
  );
  return posts.map((post, i) => ({
    params: { id: post.id },
    props: { post, prev: posts[i - 1], next: posts[i + 1] },
  }));
}

interface Props {
  post: Post;
  prev?: Post;
  next?: Post;
}
const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);

// A contents list only earns its space on a post long enough to need one.
const sections = headings.filter((h) => h.depth === 2);
const showToc = sections.length >= 3;

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

const wordCount = (post.body ?? '').trim().split(/\s+/).filter(Boolean).length;
const readingMins = Math.max(1, Math.round(wordCount / 200));
---

<Base
  title={`${post.data.title} — Naman's World`}
  description={post.data.description}
  current="blog"
  ogType="article"
  publishedTime={post.data.pubDate}
  modifiedTime={post.data.updatedDate}
>
  <article class="post">
    <header>
      <p class="label">field note</p>
      <h1>{post.data.title}</h1>
      <p class="meta">
        <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
        <span aria-hidden="true">·</span>
        <span>{readingMins} min read</span>
        {post.data.updatedDate && (
          <span>
            · updated <time datetime={post.data.updatedDate.toISOString()}>{fmt(post.data.updatedDate)}</time>
          </span>
        )}
        {post.data.tags.map((t) => <span class="tagchip">{t}</span>)}
      </p>
    </header>

    {showToc && (
      <nav class="toc" aria-labelledby="toc-head">
        <p class="label" id="toc-head">on this page</p>
        <ol>
          {sections.map((h) => (
            <li><a href={`#${h.slug}`}>{h.text}</a></li>
          ))}
        </ol>
      </nav>
    )}

    <div class="prose">
      <Content />
    </div>

    <aside class="author-card" aria-label="About the author">
      <p class="label">the author</p>
      <p class="author-name">Naman Gururani</p>
      <p class="author-role">Data and Backend Engineer · payments and streaming</p>
      <ul class="author-links">
        <li><a href="/portfolio/">Résumé</a></li>
        <li><a href="https://github.com/Naman-Gururani">GitHub</a></li>
        <li><a href="/blog/">Blog</a></li>
      </ul>
    </aside>

    {(prev || next) && (
      <nav class="post-nav" aria-label="More field notes">
        {prev && (
          <a class="card post-step prev" href={`/blog/${prev.id}/`} rel="prev">
            <span class="label">← previous</span>
            <span class="step-title">{prev.data.title}</span>
          </a>
        )}
        {next && (
          <a class="card post-step next" href={`/blog/${next.id}/`} rel="next">
            <span class="label">next →</span>
            <span class="step-title">{next.data.title}</span>
          </a>
        )}
      </nav>
    )}

    <a class="backlink" href="/blog/">← Back to the Library</a>
  </article>
</Base>
